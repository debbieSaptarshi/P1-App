EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Local API. Store builds must use HTTPS via EAS secrets — never localhost.
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_DEMO_MODE=false
# Facebook Login is off in production store builds. Set true only to test it.
EXPO_PUBLIC_ENABLE_FACEBOOK=false
EXPO_PUBLIC_SUPPORT_EMAIL=support@sevenlabs.app
# Optional overrides. Defaults: $EXPO_PUBLIC_API_URL/legal/privacy, /legal/terms, /legal/delete-account
# EXPO_PUBLIC_PRIVACY_URL=https://api.example.com/legal/privacy
# EXPO_PUBLIC_TERMS_URL=https://api.example.com/legal/terms
# EXPO_PUBLIC_DELETION_URL=https://api.example.com/legal/delete-account
# EXPO_PUBLIC_SUPPORT_URL=mailto:support@sevenlabs.app
# EXPO_PUBLIC_SENTRY_DSN=
# Optional __DEV__ auto sign-in: open /(auth)/sign-in?autologin=1
# EXPO_PUBLIC_DEV_AUTO_LOGIN_EMAIL=you@example.com
# EXPO_PUBLIC_DEV_AUTO_LOGIN_PASSWORD=your-dev-password
